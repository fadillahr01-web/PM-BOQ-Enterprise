generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int      @id @default(autoincrement())
  namaProject   String   @map("nama_project")
  klien         String
  lokasi        String
  nilaiKontrak  Float    @map("nilai_kontrak")
  tanggalMulai  DateTime @map("tanggal_mulai")
  targetSelesai DateTime @map("target_selesai")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("projects")
}
