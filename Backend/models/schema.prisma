datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  engineType      = "wasm"
  previewFeatures = ["driverAdapters"]
}

// Biarkan model Project ini tetap ada di bawahnya
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
}