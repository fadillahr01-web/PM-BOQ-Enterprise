generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  PROJECT_MANAGER
  SUPERVISOR
  STAFF
  CLIENT_VIEWER
}

enum TaskStatus {
  NOT_STARTED
  ON_PROGRESS
  DONE
  PENDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  NOT_STARTED
  ON_PROGRESS
  DONE
  PENDING
  CANCEL
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  PENDING
  CANCEL
  BOQ
  SURVEY
  TENDER
  PO
  SPK
  BAUT
  BAST
}

// ── Models ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ProjectMember[]
  assignedTasks Task[]        @relation("TaskAssignee")
  milestones  ProjectMilestone[] @relation("MilestonePIC")
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  clientName      String
  location        String
  budget          Decimal       @db.Decimal(15, 2)
  actualCost      Decimal       @default(0.00) @db.Decimal(15, 2)
  startDate       DateTime
  endDate         DateTime
  plannedProgress Float         @default(0.0)
  actualProgress  Float         @default(0.0)
  status          ProjectStatus @default(IN_PROGRESS)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members       ProjectMember[]
  tasks         Task[]
  boqCategories BoqCategory[]
  boqs          BOQ[]
  documents     Document[]
  milestones    ProjectMilestone[]
  progressLogs  ProgressLog[]
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      TaskStatus @default(NOT_STARTED)
  priority    Priority   @default(MEDIUM)
  progress    Float      @default(0.0)
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subTasks SubTask[]
}

model SubTask {
  id          String  @id @default(cuid())
  taskId      String
  name        String
  isCompleted Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model BoqCategory {
  id        String @id @default(cuid())
  projectId String
  name      String

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BoqItem[]
}

model BoqItem {
  id          String  @id @default(cuid())
  categoryId  String
  type        String
  materialId  String?
  serviceId   String?
  description String
  merk        String?
  volume      Float
  unit        String
  unitPrice   Decimal @db.Decimal(15, 2)
  totalPrice  Decimal @db.Decimal(15, 2)
  progress    Float   @default(0.0)
  remarks     String?

  category BoqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  material Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  service  Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Material {
  id        String   @id @default(cuid())
  name      String
  unit      String
  unitPrice Decimal  @db.Decimal(15, 2)
  merk      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boqItems BoqItem[]
}

model Service {
  id        String   @id @default(cuid())
  name      String
  unit      String
  unitPrice Decimal  @db.Decimal(15, 2)
  merk      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boqItems BoqItem[]
}

model MasterKomponen {
  id            String   @id @default(cuid())
  kode          String   @unique
  namaKomponen  String
  satuan        String
  hargaSatuan   Decimal  @db.Decimal(15, 2)
  tipe          String   @default("PERANGKAT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  boqItemDetails BOQItemDetail[]
}

model BOQ {
  id          String   @id @default(cuid())
  projectId   String
  namaBoq     String
  keterangan  String?
  tanggalBuat DateTime @default(now())
  status      String   @default("DRAFT")
  totalHarga  Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BOQItemDetail[]

  @@index([projectId])
}

model BOQItemDetail {
  id               String  @id @default(cuid())
  boqId            String
  masterKomponenId String
  volume           Float
  hargaSatuan      Decimal @db.Decimal(15, 2)
  totalHarga       Decimal @db.Decimal(15, 2)
  keterangan       String?

  boq            BOQ            @relation(fields: [boqId], references: [id], onDelete: Cascade)
  masterKomponen MasterKomponen @relation(fields: [masterKomponenId], references: [id])

  @@index([boqId])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMilestone {
  id        String          @id @default(cuid())
  projectId String
  stage     Int
  name      String
  status    MilestoneStatus @default(NOT_STARTED)
  updatedAt DateTime        @updatedAt
  picId     String?
  metadata  Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pic     User?   @relation("MilestonePIC", fields: [picId], references: [id], onDelete: SetNull)
}

model ProgressLog {
  id              String   @id @default(cuid())
  projectId       String
  week            Int
  plannedProgress Float
  actualProgress  Float
  logDate         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, week])
}
