generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  SUPERVISOR
  STAFF
  CLIENT_VIEWER
}

enum TaskStatus {
  NOT_STARTED
  ON_PROGRESS
  DONE
  PENDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
