{
  "name": "pm-boq-enterprise",
  "version": "1.0.0",
  "description": "Root package for PM-BOQ Enterprise",
  "scripts": {
    "install:all": "npm install --prefix Backend && npm install --prefix Frontend",
    "dev:backend": "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "dev": "npx -y concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "prisma:generate": "npx prisma generate --schema=Backend/models/schema.prisma",
    "prisma:push": "npx prisma db push --schema=Backend/models/schema.prisma",
    "vercel-build": "npx prisma generate --schema=Backend/models/schema.prisma && cd Frontend && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
